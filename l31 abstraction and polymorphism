"class abstraction"
from abc import ABC, abstractmethod
class ABSclass(ABC):
    def print(self, x):
        print("passed value :", x)
    @abstractmethod
    def task(self):
        print("we are INSIDE absclass task")
class testclass(ABSclass):
    def task(self):
        print("we are INSIDE testclass task")
testobject = testclass()
testobject.task()
testobject.print(100)

"class animal"
class animal(ABC):
    @abstractmethod
    def move(self):
        pass
class human(animal):
    def move(self):
        print("i can walk and run!! and you cant ahahahha")
class snake(animal):
    def move(self):
        print("i can slither and crawl and poison yoiu!!")
class dog(animal):
