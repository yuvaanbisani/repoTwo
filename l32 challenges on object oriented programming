
import random
#overload operations
class A:
    def __init__(self, a):
        self.a = a
    def __lt__(self, other):
        if self.a < other.a:
            return "ob1 is less than ob2"
        else:
            return "ob2 is less than ob1"
    def __eq__(self, other):
        if self.a == other.a:
            return "both are equal"
        else:
            return "not equal"
ob1 = A(45)
ob2 = A(46)
print("passed values :", ob1.a, ob2.a)

#flashcards
class flashcards:
    def __init__(self, word, meaning):
        self.word = word
        self.meaning = meaning
    def __str__(self):
        return self.word + "(" + self.meaning + ")"
flash = []
print("welcome to flashcard! app")
while True:
    word = input("enter a word to add to flashcard : ")
    meaning = input("enter a meaning of the word : ")
    flash.append(flashcards(word, meaning))
    option = int(input("enter 0 to add a flashcard or 1 to exit : "))
    if option:
        break
print("your flashcards : ")
for i in flash:
    print(">", i)

